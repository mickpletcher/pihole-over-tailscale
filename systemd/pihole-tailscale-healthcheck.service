[Unit]
Description=Pi-hole over Tailscale Layer 1 health check
After=network-online.target tailscaled.service pihole-FTL.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/pihole-tailscale/health-check.sh --quiet --server <PIHOLE_TAILSCALE_IP>
SuccessExitStatus=1
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
UMask=0077
